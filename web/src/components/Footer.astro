---
import Default from '@astrojs/starlight/components/Footer.astro';
import app from '../data/app.json';
---
<Default {...Astro.props}><slot /></Default>
<div class="site-footer">
  <span>MCS51 Studio · Docs for v{app.version}</span>
  <div><a href={`${import.meta.env.BASE_URL}reference/license/`}>License</a><a href="https://github.com/bibekjoshi01/mcs51-studio/issues">Report an issue</a></div>
</div>
<style>
  .site-footer { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; padding-top: 1.5rem; margin-top: 2.5rem; border-top: 1px solid var(--sl-color-hairline); color: var(--sl-color-gray-2); font-size: .875rem; }
  .site-footer div { display: flex; gap: 1.25rem; }
  a { color: inherit; text-underline-offset: .2em; }
  a:hover { color: var(--sl-color-text-accent); }
</style>
