---
import logo from '../assets/logo.svg';
const home = import.meta.env.BASE_URL;
---
<a class="site-brand" href={home}>
  <img src={logo.src} width="34" height="34" alt="" />
  <span>MCS51 <strong>Studio</strong></span>
  <span class="docs-label">Docs</span>
</a>
<style>
  .site-brand { display: flex; align-items: center; gap: .65rem; color: var(--sl-color-white); text-decoration: none; white-space: nowrap; font-size: 1.1rem; letter-spacing: -.035em; }
  .site-brand strong { font-weight: 500; }
  .site-brand > span:first-of-type { font-weight: 750; }
  .docs-label { border-left: 1px solid var(--sl-color-gray-5); padding-left: .75rem; margin-left: .15rem; color: var(--sl-color-gray-2); font-size: .875rem; letter-spacing: 0; }
  @media (max-width: 380px) { .docs-label { display: none; } }
</style>
